{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed backend capability evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "backend",
    "runtime_version",
    "game",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "backend": {
      "type": "string"
    },
    "runtime_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "game": {
      "enum": [
        "bof3",
        "bof4"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "source",
          "local_test"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "documented",
              "probed",
              "runtime-tested",
              "experimental",
              "unavailable",
              "unverified"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "local_test": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
